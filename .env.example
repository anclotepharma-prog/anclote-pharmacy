# Copy to .env.local for local dev. In production, set these in the Vercel
# project dashboard under Settings > Environment Variables.

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Get it from https://analytics.google.com when the GA4 property is created.
# When empty, the analytics tag is not rendered and the site works normally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
